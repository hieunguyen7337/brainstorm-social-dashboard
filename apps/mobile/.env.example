# Copy to .env.local for local development (never commit secrets; none are needed here).
# Same-origin API on web; native builds use this URL (eas.json sets it per profile).
EXPO_PUBLIC_API_URL=http://localhost:8000
# Run against the in-memory fake API (offline demo / development without the backend).
# EXPO_PUBLIC_MOCK=1
# Display name override (defaults to "Pulse").
# EXPO_PUBLIC_APP_NAME=Pulse
