{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://pulse-hackathon.fly.dev" }
    },
    "ios-sim": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_API_URL": "https://pulse-hackathon.fly.dev" }
    },
    "production": {
      "channel": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://pulse-hackathon.fly.dev" }
    }
  },
  "submit": {
    "production": {}
  }
}
