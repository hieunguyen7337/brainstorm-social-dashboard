{
  "name": "pulse-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse Desktop: Electron shell for the Pulse web app",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "renderer": "node scripts/renderer.mjs",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "prepackage": "node scripts/check-renderer.mjs && node scripts/build.mjs",
    "dist:mac": "npm run prepackage && electron-builder --mac --publish never",
    "dist:win": "npm run prepackage && electron-builder --win --publish never",
    "dist": "npm run prepackage && electron-builder --mac --win --publish never"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.12.1",
    "@types/node": "24.0.0",
    "electron": "45.4.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.5",
    "typescript": "5.8.3",
    "zod": "3.25.46"
  }
}
